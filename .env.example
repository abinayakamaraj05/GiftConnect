# GiftConnect local environment template — copy to .env and fill in.
# .env is git-ignored; NEVER commit real credentials.

# MySQL (already required by the app)
DB_PASSWORD=your_mysql_password

# SMTP for OTP verification emails (Gmail App Password, NOT the account password)
# Create one at https://myaccount.google.com/apppasswords (requires 2-Step Verification)
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your16charapppassword

# Optional overrides
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM=no-reply@giftconnect.local
